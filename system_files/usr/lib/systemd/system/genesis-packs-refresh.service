[Unit]
Description=Genesis: fetch the signed model-pack definitions before first run
Documentation=https://github.com/matijagorsek/genesis
After=network-online.target
Wants=network-online.target
Before=genesis-firstrun.service
ConditionPathExists=!/var/lib/genesis/first-run-done

[Service]
Type=oneshot
Environment=GENESIS_PACKS_STATE=/var/lib/genesis/packs
ExecStart=/usr/bin/genesis-packs refresh
TimeoutStartSec=120
SuccessExitStatus=0 1 2

[Install]
WantedBy=multi-user.target
