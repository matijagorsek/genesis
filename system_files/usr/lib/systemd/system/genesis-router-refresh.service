[Unit]
Description=Genesis: rewrite the router config when the image has changed under it
Documentation=https://github.com/matijagorsek/genesis
# The precondition is that there is a config to refresh, not that a marker was written. Keying on the
# first-run marker looked equivalent and is not: a machine whose models were downloaded but whose wizard
# was never finished has a complete, working setup and no marker — and skipped this entirely, which is
# exactly the machine that most needed it. A machine with no config yet will get one from the wizard.
ConditionPathExists=/etc/genesis/router.yaml
After=genesis-probe.service network-online.target
Before=genesis-router.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The router config is written once, at first run, and the wizard never starts again. So an upgrade that
# changes how models should be started — which devices to use, what may stay in memory, which wrapper
# starts them — reaches /usr and stops there. Every machine already installed keeps the config it was
# given on the day it was installed, forever. This compares the image the config was written for with the
# image now booted, and writes it again when they differ.
ExecStart=/usr/bin/bash -c '\
  now=$(. /usr/lib/os-release; echo "$IMAGE_VERSION"); \
  was=$(cat /var/lib/genesis/router-written-for 2>/dev/null || echo none); \
  if [ "$now" != "$was" ]; then \
    echo "the config was written for $was and this is $now: writing it again"; \
    /usr/bin/genesis-firstrun --render-router && mkdir -p /var/lib/genesis && echo "$now" > /var/lib/genesis/router-written-for; \
  else echo "the config was written for this image already"; fi'

[Install]
WantedBy=multi-user.target
