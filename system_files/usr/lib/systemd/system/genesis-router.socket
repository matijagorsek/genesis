# On-demand activation of the router. TODO(phase1): verify llama-swap honours LISTEN_FDS; if not, front it with systemd-socket-proxyd.
[Unit]
Description=Genesis local AI router socket

[Socket]
ListenStream=/run/genesis/ai.sock
ListenStream=127.0.0.1:8080
SocketUser=genesis-ai
SocketGroup=genesis-users
SocketMode=0660

[Install]
WantedBy=sockets.target
