# Genesis local AI router (llama-swap): one OpenAI-compatible endpoint on 127.0.0.1:8080.
# llama-swap binds the port itself (no socket activation: a socket unit on the same port made it crash-loop).
# It starts once the first-run wizard has rendered the router config; the wizard starts it right after.
[Unit]
Description=Genesis local AI router (llama-swap)
Documentation=https://github.com/mostlygeek/llama-swap
After=network.target
ConditionPathExists=/etc/genesis/router.yaml

[Service]
User=genesis-ai
Group=genesis-ai
SupplementaryGroups=video render
ExecStart=/usr/bin/llama-swap --config /etc/genesis/router.yaml --listen 127.0.0.1:8080
Restart=on-failure
RestartSec=2

# resource control: protect the desktop
MemoryMax=80%
MemorySwapMax=0
TasksMax=4096
IOWeight=50
CPUWeight=80
OOMPolicy=kill

# hardening, device allow-list
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/genesis /var/cache/genesis /run/genesis
PrivateTmp=yes
NoNewPrivileges=yes
DevicePolicy=closed
# device classes, not paths: a directory such as /dev/dri is not a device node and systemd ignores it,
# which left the render node closed and the models on the CPU (found by audit, confirmed in a VM, 17 Sep)
DeviceAllow=char-drm rw
DeviceAllow=char-kfd rw
DeviceAllow=char-nvidia* rw
RuntimeDirectory=genesis
StateDirectory=genesis
CacheDirectory=genesis

[Install]
WantedBy=multi-user.target
