{
  "name": "genesis-babel",
  "displayName": "Genesis",
  "description": "The maker at your side: make and change things in this workspace with the local models, every step permission-gated; inline completion from the small local model in every language; ask about the selection; Genesis Dark.",
  "version": "0.1.0",
  "publisher": "genesis",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genesis",
          "title": "Genesis",
          "icon": "media/genesis.svg"
        }
      ]
    },
    "views": {
      "genesis": [
        {
          "type": "webview",
          "id": "genesis.maker",
          "name": "Maker"
        }
      ]
    },
    "commands": [
      {
        "command": "genesis.make",
        "title": "Genesis: Make something in this workspace…"
      },
      {
        "command": "genesis.askSelection",
        "title": "Genesis: Ask about the selection"
      },
      {
        "command": "genesis.changeFile",
        "title": "Genesis: Change this file…"
      },
      {
        "command": "genesis.openMaker",
        "title": "Genesis: Open the maker window"
      },
      {
        "command": "genesis.settings",
        "title": "Genesis: Settings"
      },
      {
        "command": "genesis.openInBabel",
        "title": "Genesis: Open a made project in Babel…"
      },
      {
        "command": "genesis.welcome",
        "title": "Babel: Welcome"
      },
      {
        "command": "genesis.toggleCompletion",
        "title": "Babel: Turn local completion on or off"
      },
      {
        "command": "genesis.inline",
        "title": "Genesis: Change the selection…"
      },
      {
        "command": "genesis.explainError",
        "title": "Genesis: Explain this error"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "genesis.inline",
          "group": "genesis@0"
        },
        {
          "command": "genesis.askSelection",
          "when": "editorHasSelection",
          "group": "genesis@1"
        },
        {
          "command": "genesis.changeFile",
          "group": "genesis@2"
        },
        {
          "command": "genesis.explainError",
          "group": "genesis@3"
        }
      ],
      "explorer/context": [
        {
          "command": "genesis.make",
          "group": "genesis@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "genesis.make",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      },
      {
        "command": "genesis.askSelection",
        "key": "ctrl+alt+a",
        "when": "editorHasSelection"
      },
      {
        "command": "genesis.inline",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      }
    ],
    "themes": [
      {
        "label": "Genesis Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/genesis-dark.json"
      }
    ],
    "configuration": {
      "title": "Genesis",
      "properties": {
        "genesis.agentd": {
          "type": "string",
          "default": "",
          "description": "The Genesis maker daemon. Empty: this user's own, on this machine."
        },
        "genesis.router": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "The model service on this machine (llama-swap), used for inline completion."
        },
        "genesis.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Inline suggestions from the local model while you type, in every language. Nothing leaves this machine."
        }
      }
    },
    "configurationDefaults": {
      "workbench.colorTheme": "Genesis Dark",
      "workbench.startupEditor": "none",
      "editor.fontFamily": "'IBM Plex Mono', 'JetBrains Mono', monospace",
      "editor.fontSize": 14,
      "terminal.integrated.fontFamily": "'IBM Plex Mono', monospace"
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  }
}
