[Desktop Entry]
Type=Application
Name=Babel
GenericName=Code editor
Comment=The Genesis IDE: every language, with the maker at your side
Exec=/usr/bin/babel --ozone-platform-hint=auto %F
Icon=babel
Terminal=false
StartupWMClass=Babel
Categories=Development;IDE;
Keywords=babel;code;ide;editor;genesis;
MimeType=text/plain;inode/directory;
