# Genesis defaults. Keeps Aurora/Fedora kde-settings Wayland keys; adds Genesis look.
[Wayland]
InputMethod[$e]=/usr/share/applications/org.kde.plasma.keyboard.desktop
VirtualKeyboardEnabled=true
EnablePrimarySelection=false

[org.kde.kdecoration2]
library=org.kde.breeze
BorderSize=None
BorderSizeAuto=false
ButtonsOnLeft=
ButtonsOnRight=IAX

[Plugins]
blurEnabled=true
translucencyEnabled=false
slideEnabled=true
kwin4_effect_fadingpopupsEnabled=true
kwin4_effect_scaleEnabled=true
overviewEnabled=true

[Effect-blur]
BlurStrength=8
NoiseStrength=2

[TabBox]
LayoutName=thumbnail_grid
