#!/usr/bin/python3
"""genesis-packs: signed model-pack definitions from GHCR.

  refresh          pull every pack definition (ghcr.io/<owner>/genesis-packs:<id>) through skopeo, which
                   enforces the containers signature policy (release key in /etc/pki/genesis/cosign.pub),
                   and keep the verified JSON under the packs state directory
  status           JSON: which packs have a signed definition, when it was resolved

The first-run wizard and the Settings page prefer these definitions over the built-in list: they carry
the exact file names, sizes and sha256 of every model, so each download is checked against something
Genesis signed. Without network (or before the first refresh) the built-in list still works.
"""
import glob, json, os, subprocess, sys, tempfile

REPO = os.environ.get("GENESIS_PACKS_REPO", "ghcr.io/matijagorsek/genesis-packs")
BUILTIN = "/usr/share/genesis/packs"
STATE = os.environ.get("GENESIS_PACKS_STATE", os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "genesis", "packs"))


def pack_ids():
    return sorted(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(BUILTIN, "*.json")) if not p.endswith("schema.json"))


def refresh():
    """skopeo copy applies /etc/containers/policy.json to the source (the release key must have signed the
    artifact) and writes an OCI layout; the pack JSON is the single layer blob of that manifest."""
    os.makedirs(STATE, exist_ok=True)
    result = {"repo": REPO, "ok": [], "failed": {}}
    for pid in pack_ids():
        ref = f"{REPO}:{pid}"
        try:
            with tempfile.TemporaryDirectory() as td:
                cp = subprocess.run(["skopeo", "copy", "--remove-signatures", f"docker://{ref}", f"oci:{td}:{pid}"], capture_output=True, text=True, timeout=300)
                if cp.returncode != 0:
                    err = cp.stderr.strip().splitlines()
                    result["failed"][pid] = (err[-1] if err else "copy failed")[:300]
                    continue
                index = json.load(open(os.path.join(td, "index.json")))
                mdigest = index["manifests"][0]["digest"].split(":", 1)[1]
                manifest = json.load(open(os.path.join(td, "blobs", "sha256", mdigest)))
                layers = manifest.get("layers", [])
                if len(layers) != 1:
                    result["failed"][pid] = f"expected one layer, got {len(layers)}"
                    continue
                ldigest = layers[0]["digest"].split(":", 1)[1]
                doc = json.load(open(os.path.join(td, "blobs", "sha256", ldigest)))
                if doc.get("id") != pid or not doc.get("files"):
                    result["failed"][pid] = "unexpected content"
                    continue
                tmp = os.path.join(STATE, f".{pid}.json.tmp")
                with open(tmp, "w") as f:
                    json.dump(doc, f)
                os.replace(tmp, os.path.join(STATE, f"{pid}.json"))
                result["ok"].append(pid)
        except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, IndexError) as e:
            result["failed"][pid] = str(e)[:300]
    return result


def status():
    out = {"repo": REPO, "packs": {}}
    for pid in pack_ids():
        p = os.path.join(STATE, f"{pid}.json")
        try:
            doc = json.load(open(p))
            out["packs"][pid] = {"signed": True, "resolved_at": doc.get("resolved_at"), "files": len(doc.get("files", []))}
        except (OSError, ValueError):
            out["packs"][pid] = {"signed": False}
    return out


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "refresh":
        print(json.dumps(refresh()))
    elif cmd == "status":
        print(json.dumps(status()))
    else:
        print(__doc__); return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
