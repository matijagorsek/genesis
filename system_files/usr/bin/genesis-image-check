#!/usr/bin/env bash
set -euo pipefail
ok(){ printf '  ok   %s\n' "$1"; }
fail(){ printf '  FAIL %s\n' "$1"; rc=1; }
rc=0
echo "Genesis image check"
grep -q '^ID=genesis' /usr/lib/os-release && ok "os-release ID=genesis" || fail "os-release"
grep '^PRETTY_NAME' /usr/lib/os-release
for b in llama-server llama-swap ramalama bwrap distrobox bootc vulkaninfo genesis-permd genesis-probe genesis-firstrun genesis-agentd genesis-txd genesis-krunner genesis-ask genesis-report genesis-firstuser genesis-pick-device genesis-llama-server genesis-crash btrfs rsync firefox okular gwenview kcalc plasma-discover dolphin konsole kate; do command -v "$b" >/dev/null && ok "binary $b" || fail "binary $b"; done
# the test disks carry a known account; a password must not be accepted from a real network
if grep -q "genesis.devssh" /proc/cmdline 2>/dev/null; then
  f=/etc/ssh/sshd_config.d/99-genesis-devssh.conf
  if grep -q "genesis.devssh=any" /proc/cmdline; then ok "dev SSH unrestricted because genesis.devssh=any was asked for"
  elif [ -s "$f" ] && grep -q "^PasswordAuthentication no" "$f" && grep -q "^Match Address" "$f"; then ok "dev SSH takes a password only from a virtual machine's own network"
  else fail "this test disk accepts its known password from anywhere: $f is missing or wrong"; fi
fi
# the model service must go through the wrapper that survives a GPU failure, not straight to llama-server.
# On a machine upgraded from an older image the config is rewritten at the next boot by
# genesis-router-refresh, so say that rather than calling it a fault the person cannot fix.
if [ -f /etc/genesis/router.yaml ]; then
  if grep -q "genesis-llama-server" /etc/genesis/router.yaml; then ok "the router starts models through the fallback wrapper"
  elif [ "$(cat /var/lib/genesis/router-written-for 2>/dev/null)" != "$(. /usr/lib/os-release; echo "$IMAGE_VERSION")" ]; then ok "the router config predates this image; it is rewritten at the next boot"
  else fail "router.yaml calls llama-server directly and was written for this image: a GPU failure would leave no assistant at all"; fi
fi
[ -L /usr/lib/systemd/system/multi-user.target.wants/genesis-router-refresh.service ] && ok "an upgraded machine rewrites its router config" || fail "genesis-router-refresh is not enabled: an upgrade would never reach the config in /etc"
# a machine that installs with no account has no way in at all: the rescue must be there and enabled
[ -L /usr/lib/systemd/system/multi-user.target.wants/genesis-firstuser.service ] && ok "the no-account rescue is enabled" || fail "genesis-firstuser is not enabled: an install with no user would be unreachable"
u=genesis-router.service; [ -f "/usr/lib/systemd/system/$u" ] && ok "unit $u" || fail "unit $u"
[ -L /etc/systemd/system/multi-user.target.wants/genesis-router.service ] && ok "router service enabled" || fail "router service not enabled"
# the model service must be able to open the GPU from inside its sandbox (a closed render node means CPU only, silently)
grep -q "^DeviceAllow=char-drm" /usr/lib/systemd/system/genesis-router.service && ! grep -q "^DeviceAllow=/dev/dri" /usr/lib/systemd/system/genesis-router.service && ok "router device allow-list uses device classes (char-drm)" || fail "router unit allows /dev/dri by path: systemd ignores it and the GPU stays closed"
node=$( (ls /dev/dri/renderD* 2>/dev/null || true) | head -1)
# only on a booted system: the image build runs this script in a container, without systemd or a GPU
if [ -n "$node" ] && [ "$(id -u)" = 0 ] && [ -d /run/systemd/system ]; then
  if systemd-run --quiet --wait --pipe -p User=genesis-ai -p "SupplementaryGroups=video render" -p DevicePolicy=closed -p "DeviceAllow=char-drm rw" python3 -c "import os;os.open('$node',os.O_RDWR)" >/dev/null 2>&1; then ok "the model service user can open the GPU ($node) inside the sandbox"
  else fail "genesis-ai cannot open $node inside the sandbox: models would run on the CPU"; fi
fi
# a machine installed from the ISO must not carry the test account's password or the SSH gate
if ! grep -q "genesis.devssh=1" /proc/cmdline 2>/dev/null; then
  ok "not a test disk: the SSH gate is off"
  if [ "$(id -u)" = 0 ] && getent passwd genesis >/dev/null && python3 - <<'PYEOF' 2>/dev/null
import ctypes, ctypes.util, sys
h = next((l.split(":")[1] for l in open("/etc/shadow") if l.startswith("genesis:")), "")
lib = ctypes.CDLL(ctypes.util.find_library("crypt") or "libcrypt.so.2"); lib.crypt.restype = ctypes.c_char_p
r = lib.crypt(b"genesis", h.encode()) if h.startswith("$") else None
sys.exit(0 if r and r.decode() == h else 1)
PYEOF
  then fail "the account genesis still has the test password: change it now (passwd genesis)"; fi
fi
[ -x /usr/bin/genesis-ollama ] && [ -L /etc/systemd/system/multi-user.target.wants/genesis-ollama.service ] && ok "Ollama-compatible door (genesis-ollama on 127.0.0.1:11434)" || fail "genesis-ollama missing or not enabled"
[ -x /usr/bin/genesis-mode ] && grep -q "org.genesis.mode.desktop" /etc/xdg/kglobalshortcutsrc && [ -f /usr/share/applications/org.genesis.mode.desktop ] && ok "mode key (genesis-mode, Meta+Shift+M)" || fail "genesis-mode or its shortcut missing"
[ -x /usr/bin/kdialog ] && ok "file dialog for the pages (kdialog)" || fail "kdialog missing: Choose… buttons cannot open a dialog"
[ -x /usr/bin/genesis-file-action ] && [ -f /usr/share/kio/servicemenus/genesis-make.desktop ] && ok "right-click a file: make a tool, or ask about it" || fail "file manager menu missing"
[ -x /usr/lib/systemd/system-sleep/genesis ] && ok "a job stops cleanly when the machine sleeps" || fail "no sleep hook"
[ -x /usr/bin/genesis-read-aloud ] && grep -q "org.genesis.readaloud" /etc/xdg/kglobalshortcutsrc && ok "read the selection aloud (Meta+Shift+R)" || fail "read aloud missing"
# the door local programs use: a 0600 socket in the runtime directory, which a sandboxed command cannot see
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/genesis/agentd.sock" ]; then
  [ "$(stat -c %a "$XDG_RUNTIME_DIR/genesis/agentd.sock")" = 600 ] && ok "maker socket for local programs (0600)" || fail "the maker socket is not 0600"
fi
[ -f /usr/lib/genesis/genesis_local.py ] && grep -q "unix-socket\|agentd.sock" /usr/bin/genesis-mode && ok "local tools prefer the socket over the port" || fail "local tools still only use the port"
[ -s /usr/share/genesis/release-notes.md ] && ok "release notes in the image (Settings, Updates)" || fail "release notes missing"
[ -x /usr/bin/genesis-demo ] && [ -f /usr/share/applications/org.genesis.demo.desktop ] && grep -q "org.genesis.talk.desktop" /etc/xdg/kglobalshortcutsrc && ok "demo entry and talk key (Meta+Shift+V)" || fail "demo entry or talk key missing"
grep -q "def send" /usr/bin/genesis-phone && ok "phone hand-off (genesis-phone send)" || fail "genesis-phone send missing"
[ -f /usr/lib/sysusers.d/genesis.conf ] && ok "sysusers" || fail "sysusers"
[ -f /usr/lib/tmpfiles.d/genesis.conf ] && ok "tmpfiles" || fail "tmpfiles"
[ -d /etc/genesis ] && ok "/etc/genesis" || fail "/etc/genesis"
[ -f /usr/share/genesis/policy.d/00-default.toml ] && ok "default policy" || fail "default policy"
[ -f /etc/hostname ] && ! grep "^kargs" /usr/lib/bootc/kargs.d/10-genesis.toml | grep -q "systemd.hostname" && ok "hostname from /etc/hostname (changeable)" || fail "the hostname is forced by a kernel argument"
[ -d /usr/share/genesis/packs ] && [ "$(ls /usr/share/genesis/packs/*.json 2>/dev/null | wc -l)" -ge 7 ] && ok "packs shipped" || fail "packs shipped"
[ -L /etc/systemd/system/multi-user.target.wants/genesis-probe.service ] && ok "probe first-boot service enabled" || fail "probe service not enabled"
[ -L /etc/systemd/system/multi-user.target.wants/genesis-firstrun.service ] && ok "first-run service enabled" || fail "first-run service not enabled"
[ -f /etc/xdg/autostart/org.genesis.firstrun.desktop ] && ok "first-run autostart" || fail "first-run autostart"
[ -x /usr/bin/genesis-window ] && ok "genesis-window" || fail "genesis-window"
{ command -v chromium >/dev/null || command -v chromium-browser >/dev/null; } && ok "chromium (agent browser)" || fail "chromium"
[ -f /usr/share/color-schemes/GenesisDark.colors ] && ok "Genesis Dark color scheme" || fail "color scheme"
[ -f /usr/share/plasma/look-and-feel/org.genesis.desktop/contents/splash/Splash.qml ] && ok "Genesis splash" || fail "splash"
[ -f /usr/share/plymouth/themes/spinner/watermark.png ] && ok "Plymouth watermark" || fail "plymouth watermark"
[ -d /usr/share/fonts/rsms-inter-fonts ] && ok "Inter font" || fail "Inter font"
[ -d /usr/share/fonts/ibm-plex-mono-fonts ] && ok "IBM Plex Mono font" || fail "Plex Mono font"
[ -d /usr/share/icons/Papirus-Dark ] && ok "Papirus-Dark icons" || fail "Papirus-Dark icons"
[ -f /usr/share/color-schemes/GenesisLight.colors ] && [ -x /usr/bin/genesis-theme ] && ok "day / night switch" || fail "theme switch"
[ -f /usr/share/applications/org.genesis.settings.desktop ] && ok "Genesis Settings entry" || fail "settings entry"
[ -x /usr/bin/genesis-ask-selection ] && grep -q "Meta+Shift+Space" /etc/xdg/kglobalshortcutsrc && ok "select-to-act (Meta+Shift+Space)" || fail "select-to-act"
[ -f /usr/share/plasma/plasmoids/org.genesis.status/contents/ui/main.qml ] && ok "Genesis status widget" || fail "status widget"
[ -f /usr/share/kde-settings/kde-profile/default/xdg/kwinrc ] && ok "kwinrc defaults (blur, no borders)" || fail "kwinrc defaults"
[ -f /usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/genesis.conf ] && [ -L /etc/systemd/system/timers.target.wants/bootc-fetch-apply-updates.timer ] && ok "background updates: stage, apply on reboot" || fail "update policy"
[ -f /usr/share/polkit-1/rules.d/50-genesis-updates.rules ] && [ -f /usr/lib/systemd/system/genesis-bootc-status.service ] && ok "update check from Settings" || fail "update check"
[ -n "$(find /usr/lib64/qt6/plugins/plasma/kcms -name kcm_genesis.so 2>/dev/null)" ] && ok "Genesis module in System Settings" || fail "kcm_genesis"
[ -f /etc/pki/genesis/cosign.pub ] && grep -q sigstoreSigned /etc/containers/policy.json && ok "updates require the Genesis signature" || fail "signature policy"
[ -x /usr/bin/genesis-toolbox ] && [ -d /usr/share/genesis/templates/node-web ] && [ -d /usr/share/genesis/templates/rust-cli ] && ok "toolboxes and Node/Rust templates" || fail "toolbox templates"
[ -x /usr/bin/genesis-phone ] && [ -f /usr/lib/systemd/user/genesis-phone.service ] && [ -x /usr/bin/kdeconnectd ] && ok "phone bridge (KDE Connect, genesis-phone)" || fail "phone bridge missing"
[ -x /usr/bin/genesis-packs ] && [ -f /usr/lib/systemd/user/genesis-packs.timer ] && grep -q genesis-packs /etc/containers/policy.json && ok "signed pack definitions (genesis-packs, policy)" || fail "genesis-packs missing"
[ -x /usr/bin/genesis-backup ] && ok "backup and restore (genesis-backup)" || fail "genesis-backup missing"
[ "$(ls /usr/share/genesis/recipes/*.json 2>/dev/null | wc -l)" -ge 5 ] && ok "recipes shipped" || fail "recipes missing"
[ -x /usr/bin/genesis-companiond ] && [ -f /usr/lib/systemd/user/genesis-companiond.service ] && [ -x /usr/bin/qrencode ] && ok "phone companion API (genesis-companiond, qrencode)" || fail "companion daemon missing"
[ -x /usr/bin/babel ] && [ -d /usr/lib/babel/resources/app/extensions/genesis-babel ] && grep -q '"nameShort": "Babel"' /usr/lib/babel/resources/app/product.json && ok "Babel (Code-OSS, Genesis extension built in)" || fail "Babel missing"
[ -x /usr/bin/rust-analyzer ] && [ -x /usr/bin/clangd ] && [ -x /usr/bin/gopls ] && [ -d /usr/lib/babel/resources/app/extensions/ms-python.python ] && [ -d /usr/lib/babel/resources/app/extensions/golang.go ] && ok "Babel language servers (Python, TypeScript, Rust, Go, C/C++)" || fail "Babel language servers missing"
[ -x /usr/bin/lldb-dap ] && [ -x /usr/bin/dlv ] && [ -d /usr/lib/babel/resources/app/extensions/llvm-vs-code-extensions.lldb-dap ] && ok "Babel debuggers (lldb-dap for Rust and C/C++, Delve for Go, debugpy for Python)" || fail "Babel debuggers missing"
grep -q "/infill" /usr/lib/babel/resources/app/extensions/genesis-babel/extension.js 2>/dev/null && [ -L /usr/lib/babel/resources/app/extensions/ms-python.debugpy/.noConfigDebugAdapterEndpoints ] && ok "Babel local completion (fill-in-the-middle on the router) and debugpy endpoint folder redirected" || fail "Babel completion or debugpy folder"
[ -x /usr/bin/genesis-mcp-system ] && [ -f /usr/share/genesis/mcp/system.json ] && grep -q "mcp.system" /usr/share/genesis/policy.d/00-default.toml && ok "MCP tool servers (system server shipped, tiers in the policy)" || fail "MCP server or policy tiers missing"
[ -f /usr/share/applications/org.genesis.chat.desktop ] && grep -q "org.genesis.chat.desktop" /usr/share/plasma/look-and-feel/org.genesis.desktop/contents/layouts/org.kde.plasma.desktop-layout.js && grep -q "extract" /usr/bin/genesis-index && ok "chat surface (menu entry, dock, document extraction)" || fail "chat surface pieces missing"
[ -f /usr/share/genesis/chat-templates.json ] && python3 -c "import json;json.load(open('/usr/share/genesis/chat-templates.json'))" && ok "chat templates shipped" || fail "chat templates"
grep -q "v1/embeddings" /usr/bin/genesis-index && python3 -c "import numpy" 2>/dev/null && ok "file index searches by meaning (embeddings via the router, numpy)" || fail "semantic index pieces missing"
[ -x /usr/bin/genesis-index ] && [ -f /usr/lib/systemd/user/genesis-index.timer ] && [ -x /usr/bin/pdftotext ] && ok "local file index (genesis-index, pdftotext)" || fail "genesis-index missing"
[ -x /usr/bin/genesis-ask-screen ] && [ -x /usr/bin/spectacle ] && grep -q askscreen /etc/xdg/kglobalshortcutsrc && ok "ask about the screen (spectacle, Meta+Shift+A)" || fail "ask-screen missing"
[ -x /usr/bin/genesis-claude ] && [ -f /usr/share/applications/org.genesis.claude.desktop ] && ok "Claude (sign in with your account)" || fail "claude launcher"
[ -x /usr/lib/genesis/piper/piper ] && ok "piper (voice output)" || fail "piper"
[ -x /usr/lib/genesis/whisper/bin/whisper-cli ] && ok "whisper-cli (voice input)" || fail "whisper-cli"
[ -d /usr/share/plasma/look-and-feel/org.genesis.desktop ] && grep -q org.genesis.desktop /usr/share/kde-settings/kde-profile/default/xdg/kdeglobals && ok "Genesis look-and-feel default" || fail "look-and-feel"
[ -f /usr/share/wallpapers/Genesis/contents/images/2560x1600.png ] && ok "wallpaper" || fail "wallpaper"
[ -f /usr/share/icons/hicolor/scalable/apps/genesis.svg ] && ok "icon" || fail "icon"
grep -q "wallpapers/Genesis" /usr/lib/plasmalogin/defaults.conf && ok "login wallpaper" || fail "login wallpaper"
[ -f /etc/flatpak/preinstall.d/genesis.preinstall ] && ok "flatpak preinstall list (office, mail, media)" || fail "flatpak preinstall"
[ "$(readlink /etc/systemd/system/plasma-setup.service)" = "/dev/null" ] && ok "plasma-setup masked" || fail "plasma-setup not masked"
[ -L /etc/systemd/user/graphical-session.target.wants/genesis-agentd.service ] && ok "agentd user unit enabled" || fail "agentd unit not enabled"
GENESIS_TX_STORE=/tmp/genesis-check-tx genesis-txd list >/dev/null 2>&1 && ok "txd store works" || fail "txd"
[ -f /usr/share/krunner/dbusplugins/genesis.desktop ] && ok "krunner plugin registered" || fail "krunner plugin"
[ -f /usr/share/applications/org.genesis.workspace.desktop ] && ok "workspace desktop entry" || fail "workspace desktop entry"
grep -q "Meta+Space" /etc/xdg/kglobalshortcutsrc 2>/dev/null && ok "Meta+Space default shortcut" || fail "global shortcut default"
[ "$(ls -d /usr/share/genesis/templates/*/ 2>/dev/null | wc -l)" -ge 3 ] && ok "project templates shipped" || fail "templates"
if [ -x /usr/bin/growpart ] && { [ -f /usr/lib/systemd/system/bootc-generic-growpart.service ] || [ -L /etc/systemd/system/local-fs.target.wants/genesis-growpart.service ]; }; then ok "root grows into a resized disk (growpart + $([ -f /usr/lib/systemd/system/bootc-generic-growpart.service ] && echo "bootc's unit" || echo "genesis-growpart"))"
else fail "grow on boot: growpart $([ -x /usr/bin/growpart ] && echo present || echo missing), no grow unit enabled (bootc $(rpm -q bootc 2>/dev/null))"; fi
probe_out=$(genesis-probe --json 2>&1 || true)
# a machine too small for any pack is a valid probe result (the wizard offers "set up later"), not a failed probe
if grep -q '"recommended_pack": "' <<<"$probe_out"; then ok "probe: $(grep -o '"recommended_pack": "[^"]*"' <<<"$probe_out")"
elif grep -q '"recommended_pack": null' <<<"$probe_out"; then ok "probe: no pack fits this machine ($(grep -o '"ram_mb": [0-9]*' <<<"$probe_out" | head -1) MB, $(grep -o '"disk_free_mb": [0-9]*' <<<"$probe_out" | head -1) free)"
else fail "probe run"; printf '%s\n' "$probe_out" | tail -5 | sed 's/^/       /'; fi
[ -L /etc/systemd/user/default.target.wants/genesis-permd.service ] && ok "permd user service enabled" || fail "permd user service not enabled"
[ -f /usr/share/dbus-1/services/org.genesis.Permission1.service ] && ok "permd dbus activation" || fail "permd dbus activation"
permd_out=$(genesis-permd --audit /tmp/genesis-check-audit.jsonl check --cmd "pip3 install --break-system-packages x" 2>&1 || true)
if grep -q "^S1 *prompt" <<<"$permd_out"; then ok "permd: S1 prompt for --break-system-packages"; else fail "permd classification"; printf '%s\n' "$permd_out" | sed 's/^/       /'; fi
printf '  %s\n' "$(llama-server --version 2>&1 | grep -m1 -i version || true)"
printf '  %s\n' "$(llama-swap --version 2>&1 | grep -m1 -i version || true)"
printf '  genesis-permd %s\n' "$(genesis-permd --version 2>&1 | head -1 || true)"
exit $rc
