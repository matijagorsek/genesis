#!/usr/bin/python3
"""genesis-index: a local, opt-in index of the user's own files, so Genesis can answer from them.

  folders                         JSON: the folders Genesis may search, with counts
  add <folder> | remove <folder>  opt a folder in or out (the index for a removed folder is dropped)
  reset                           forget everything indexed (the opted-in folders stay)
  update                          index new and changed files in every opted-in folder (the timer runs this)
  search <query> [--json] [-n 8]  search by words (SQLite FTS5, bm25) and by meaning (embeddings from the
                                  local embed model, when the model service has one); JSON for the maker
  extract <file>                  the text of one document (for the chat's "ask about this file")
  status                          JSON: files, chunks, vectors, last update

Text is extracted from plain text, Markdown, code, PDF (pdftotext), OpenDocument and Office documents
(their XML). Nothing is uploaded: the index is a SQLite file under ~/.local/share/genesis, and only
folders the user added are read. Hidden directories, node_modules, build trees and files over 20 MB are skipped.
Embeddings come from the pack's "embed" model through the router on 127.0.0.1 (every pack ships one);
"what did I write about the trip" then finds the note that says "our week in Lisbon".
"""
import json, os, re, sqlite3, subprocess, sys, time, zipfile, struct, urllib.request
try:
    import numpy as np
except ImportError:  # pure Python fallback: fine up to a few thousand chunks
    np = None

ROUTER = os.environ.get("GENESIS_ROUTER", "http://127.0.0.1:8080")
EMBED_MODEL = "embed"
EMBED_CHARS = 1500

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "genesis", "index.json")
DB = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "genesis", "index.sqlite")
TEXT_EXT = {".txt", ".md", ".markdown", ".rst", ".org", ".tex", ".csv", ".json", ".yaml", ".yml", ".toml", ".ini", ".cfg",
            ".py", ".rs", ".js", ".ts", ".tsx", ".jsx", ".html", ".css", ".sh", ".c", ".h", ".cpp", ".go", ".java", ".kt", ".rb", ".sql", ".ics", ".eml"}
SKIP_DIRS = {"node_modules", "target", "build", "dist", ".git", "__pycache__", ".venv", "venv", ".cache"}
MAX_BYTES = 20 * 1024 * 1024
CHUNK = 1200


def load_conf():
    try:
        return json.load(open(CONF))
    except (OSError, ValueError):
        return {"folders": []}


def save_conf(c):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(c, f, indent=1)
    os.replace(tmp, CONF)


def db():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    c = sqlite3.connect(DB)
    c.execute("create table if not exists files(path text primary key, folder text, mtime real, size integer, indexed_at real)")
    c.execute("create virtual table if not exists chunks using fts5(path unindexed, ord unindexed, text, tokenize='unicode61 remove_diacritics 2')")
    c.execute("create table if not exists meta(k text primary key, v text)")
    c.execute("create table if not exists vectors(path text, ord integer, dim integer, vec blob, primary key(path, ord))")
    return c


# ---- embeddings ------------------------------------------------------------------------------

def embed(texts, timeout=300):
    """Vectors for a list of texts from the local embed model, or None when the service has no such model."""
    if not texts:
        return []
    body = json.dumps({"model": EMBED_MODEL, "input": [t[:EMBED_CHARS] for t in texts]}).encode()
    req = urllib.request.Request(ROUTER + "/v1/embeddings", data=body, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = json.load(r)["data"]
    except Exception:
        return None
    data.sort(key=lambda d: d.get("index", 0))
    return [d["embedding"] for d in data]


def pack_vec(v):
    return struct.pack(f"{len(v)}f", *v)


def unpack_vec(b, dim):
    return struct.unpack(f"{dim}f", b)


def embed_missing(c, limit=400):
    """Embed chunks that have no vector yet, a few hundred per run so the timer never blocks long."""
    rows = c.execute("select ch.path, ch.ord, ch.text from chunks ch left join vectors v on v.path=ch.path and v.ord=ch.ord where v.path is null limit ?", (limit,)).fetchall()
    if not rows:
        # everything is embedded; drop vectors of a size this model no longer produces (a pack change)
        probe = embed(["x"], timeout=60)
        if probe:
            c.execute("delete from vectors where dim<>?", (len(probe[0]),)); c.commit()
            rows = c.execute("select ch.path, ch.ord, ch.text from chunks ch left join vectors v on v.path=ch.path and v.ord=ch.ord where v.path is null limit ?", (limit,)).fetchall()
    done = 0
    for i in range(0, len(rows), 16):
        batch = rows[i:i + 16]
        vecs = embed([t for _, _, t in batch])
        if vecs is None:
            return {"embedded": done, "semantic": False}
        c.executemany("insert or replace into vectors(path, ord, dim, vec) values(?,?,?,?)", [(p, o, len(v), pack_vec(v)) for (p, o, _), v in zip(batch, vecs)])
        c.commit(); done += len(batch)
    return {"embedded": done, "semantic": True, "remaining": max(0, c.execute("select count(*) from chunks").fetchone()[0] - c.execute("select count(*) from vectors").fetchone()[0])}


def vector_search(c, query, n):
    qv = embed([query], timeout=60)
    if not qv:
        return []
    q = qv[0]
    # only vectors of this model's size: after a pack change the old ones are useless (and would raise)
    rows = c.execute("select path, ord, dim, vec from vectors where dim=?", (len(q),)).fetchall()
    if not rows:
        return []
    if np is not None:
        m = np.stack([np.frombuffer(b, dtype=np.float32) for _, _, d, b in rows])
        qa = np.array(q, dtype=np.float32)
        sims = m @ qa / (np.linalg.norm(m, axis=1) * (np.linalg.norm(qa) or 1) + 1e-9)
        order = np.argsort(-sims)[:n]
        return [(rows[int(i)][0], rows[int(i)][1], float(sims[int(i)])) for i in order]
    import math
    qn = math.sqrt(sum(x * x for x in q)) or 1.0
    out = []
    for p, o, d, b in rows:
        v = unpack_vec(b, d)
        dot = sum(a * b2 for a, b2 in zip(q, v)); vn = math.sqrt(sum(x * x for x in v)) or 1.0
        out.append((p, o, dot / (qn * vn)))
    out.sort(key=lambda t: -t[2])
    return out[:n]


def extract(path):
    ext = os.path.splitext(path)[1].lower()
    try:
        if ext == ".pdf":
            out = subprocess.run(["pdftotext", "-layout", "-q", path, "-"], capture_output=True, text=True, timeout=60)
            return out.stdout if out.returncode == 0 else ""
        if ext in (".odt", ".ods", ".odp", ".docx", ".xlsx", ".pptx"):
            with zipfile.ZipFile(path) as z:
                names = [n for n in z.namelist() if n.endswith(".xml") and ("content" in n or "document" in n or "sheet" in n or "slide" in n)]
                xml = "".join(z.read(n).decode("utf-8", "ignore") for n in names[:40])
                return re.sub(r"<[^>]+>", " ", xml)
        if ext in TEXT_EXT or ext == "":
            with open(path, "rb") as f:
                raw = f.read(MAX_BYTES)
            if b"\0" in raw[:4096]:
                return ""
            return raw.decode("utf-8", "ignore")
    except (OSError, zipfile.BadZipFile, subprocess.TimeoutExpired):
        return ""
    return ""


def chunks(text):
    text = re.sub(r"[ \t]+", " ", text)
    paras = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    buf = ""
    for p in paras:
        if len(buf) + len(p) > CHUNK and buf:
            yield buf
            buf = ""
        buf = (buf + "\n" + p) if buf else p
        while len(buf) > CHUNK * 2:
            yield buf[:CHUNK * 2]
            buf = buf[CHUNK * 2:]
    if buf:
        yield buf


def walk(folder):
    for root, dirs, files in os.walk(folder):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in SKIP_DIRS]
        for f in files:
            if f.startswith("."):
                continue
            p = os.path.join(root, f)
            try:
                st = os.stat(p)
            except OSError:
                continue
            if st.st_size > MAX_BYTES or not os.path.isfile(p):
                continue
            yield p, st


def update():
    conf = load_conf(); c = db(); seen = set(); added = changed = 0
    for folder in conf.get("folders", []):
        if not os.path.isdir(folder):
            continue
        for p, st in walk(folder):
            seen.add(p)
            row = c.execute("select mtime, size from files where path=?", (p,)).fetchone()
            if row and abs(row[0] - st.st_mtime) < 1 and row[1] == st.st_size:
                continue
            text = extract(p)
            c.execute("delete from chunks where path=?", (p,)); c.execute("delete from vectors where path=?", (p,))
            if text.strip():
                c.executemany("insert into chunks(path, ord, text) values(?,?,?)", [(p, i, t) for i, t in enumerate(chunks(text))])
            c.execute("insert or replace into files(path, folder, mtime, size, indexed_at) values(?,?,?,?,?)", (p, folder, st.st_mtime, st.st_size, time.time()))
            if row: changed += 1
            else: added += 1
    gone = [r[0] for r in c.execute("select path from files").fetchall() if r[0] not in seen]
    for p in gone:
        c.execute("delete from chunks where path=?", (p,)); c.execute("delete from vectors where path=?", (p,)); c.execute("delete from files where path=?", (p,))
    c.execute("insert or replace into meta(k, v) values('updated_at', ?)", (time.strftime("%Y-%m-%dT%H:%M:%S"),))
    c.commit()
    emb = embed_missing(c)
    return {"added": added, "changed": changed, "removed": len(gone), "files": c.execute("select count(*) from files").fetchone()[0], **emb}


def search(query, n=8):
    c = db()
    # by words: any term may match; bm25 ranks passages with more of them higher
    q = " OR ".join(f'"{t}"' for t in re.findall(r"\w+", query)) or '""'
    words = c.execute("select path, ord, snippet(chunks, 2, '[', ']', '…', 24), bm25(chunks) from chunks where chunks match ? order by bm25(chunks) limit ?", (q, max(n * 4, 20))).fetchall()
    # by meaning: the closest vectors; the two lists are fused by rank so either kind of hit can win
    meaning = vector_search(c, query, max(n * 4, 20))
    fused = {}
    for rank, (p, o, sn, sc) in enumerate(words):
        fused.setdefault((p, o), {"path": p, "chunk": o, "snippet": sn.replace("\n", " "), "score": 0.0, "by": []})
        fused[(p, o)]["score"] += 1.0 / (10 + rank); fused[(p, o)]["by"].append("words")
    for rank, (p, o, sim) in enumerate(meaning):
        if (p, o) not in fused:
            t = c.execute("select text from chunks where path=? and ord=?", (p, o)).fetchone()
            sn = (t[0] if t else "")[:180]
            fused[(p, o)] = {"path": p, "chunk": o, "snippet": sn.replace("\n", " "), "score": 0.0, "by": []}
        fused[(p, o)]["score"] += 1.0 / (10 + rank); fused[(p, o)]["by"].append("meaning")
    out = sorted(fused.values(), key=lambda h: -h["score"])[:max(n * 3, 12)]
    out = rerank(c, query, out, n)[:n]
    for h in out:
        h["score"] = round(h["score"], 4); h["by"] = "+".join(h["by"])
    return out


def rerank(c, query, hits, n):
    """Packs with a reranker (llama-server --reranking) re-score the fused candidates against the query;
    without one, or when it does not answer, the fused order stands."""
    if len(hits) < 2:
        return hits
    docs = []
    for h in hits:
        t = c.execute("select text from chunks where path=? and ord=?", (h["path"], h["chunk"])).fetchone()
        docs.append((t[0] if t else h["snippet"])[:EMBED_CHARS])
    body = json.dumps({"model": "rerank", "query": query, "documents": docs, "top_n": len(docs)}).encode()
    req = urllib.request.Request(ROUTER + "/v1/rerank", data=body, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            results = json.load(r).get("results", [])
    except Exception:
        return hits
    scored = []
    for res in results:
        i = res.get("index"); sc = res.get("relevance_score")
        if isinstance(i, int) and 0 <= i < len(hits) and sc is not None:
            scored.append((float(sc), hits[i]))
    if len(scored) < 2:
        return hits
    scored.sort(key=lambda t: -t[0])
    out = []
    for sc, h in scored:
        h["score"] = sc; h["by"].append("rerank"); out.append(h)
    return out


def status():
    c = db(); conf = load_conf()
    counts = dict(c.execute("select folder, count(*) from files group by folder").fetchall())
    upd = c.execute("select v from meta where k='updated_at'").fetchone()
    return {"folders": [{"path": f, "files": counts.get(f, 0)} for f in conf.get("folders", [])],
            "files": c.execute("select count(*) from files").fetchone()[0], "chunks": c.execute("select count(*) from chunks").fetchone()[0],
            "vectors": c.execute("select count(*) from vectors").fetchone()[0],
            "updated_at": upd[0] if upd else None, "db": DB}


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd in ("status", "folders"):
        print(json.dumps(status()))
    elif cmd == "add" and len(argv) > 2:
        conf = load_conf(); f = os.path.abspath(os.path.expanduser(argv[2]))
        if os.path.isdir(f) and f not in conf["folders"]:
            conf["folders"].append(f); save_conf(conf)
        print(json.dumps(update()))
    elif cmd == "remove" and len(argv) > 2:
        conf = load_conf(); f = os.path.abspath(os.path.expanduser(argv[2]))
        conf["folders"] = [x for x in conf["folders"] if x != f]; save_conf(conf)
        c = db()
        c.execute("delete from chunks where path in (select path from files where folder=?)", (f,))
        c.execute("delete from vectors where path in (select path from files where folder=?)", (f,))  # or an opted-out folder still answers meaning searches
        c.execute("delete from files where folder=?", (f,)); c.commit()
        print(json.dumps(status()))
    elif cmd == "reset":
        # forget everything indexed; the opted-in folders stay and are indexed again on the next run
        c = db(); c.execute("delete from chunks"); c.execute("delete from vectors"); c.execute("delete from files"); c.commit()
        print(json.dumps(status()))
    elif cmd == "update":
        print(json.dumps(update()))
    elif cmd == "embed":
        print(json.dumps(embed_missing(db(), 100000)))
    elif cmd == "extract" and len(argv) > 2:
        # the text of one document (PDF, Office, OpenDocument, Markdown, code), for the chat's "ask about this file"
        print(extract(os.path.abspath(os.path.expanduser(argv[2]))) or "")
    elif cmd == "search" and len(argv) > 2:
        args = [a for a in argv[2:] if not a.startswith("-")]
        n = 8
        if "-n" in argv:
            n = int(argv[argv.index("-n") + 1]); args = [a for a in args if a != str(n)]
        hits = search(" ".join(args), n)
        if "--json" in argv:
            print(json.dumps(hits))
        else:
            for h in hits:
                print(f"{h['path']}\n    {h['snippet']}")
    else:
        print(__doc__); return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
