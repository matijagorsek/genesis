# Genesis defaults: Meta+Space opens the palette (one door: makes go to the maker, questions to chat). Users can change this in System Settings > Shortcuts.
[services][org.genesis.palette.desktop]
_launch=Meta+Space

# Meta+Shift+Space: ask Genesis about the current selection.
[services][org.genesis.ask-selection.desktop]
_launch=Meta+Shift+Space

# Meta+Shift+T: day / night for the whole desktop.
[services][org.genesis.theme.desktop]
_launch=Meta+Shift+T

[services][org.genesis.askscreen.desktop]
_launch=Meta+Shift+A

# Meta+Shift+M: cycle the autonomy mode (Ask, Trusted, Hands-off).
[services][org.genesis.mode.desktop]
_launch=Meta+Shift+M

# Meta+Shift+V: talk to Genesis (listens at once, sends when you pause).
[services][org.genesis.talk.desktop]
_launch=Meta+Shift+V
